{
  "name": "stylo",
  "version": "0.1.0",
  "description": "Stylo — editor de design local, onde o canvas é CSS de verdade, operado por você e por agentes de IA (MCP).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "build": "npm run build -w apps/studio",
    "start": "node scripts/start.mjs",
    "test": "node --import tsx --import ./tests/_setup.mjs --test --test-timeout=90000 tests/*.test.js tests/*.test.ts",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "typecheck": "tsc -p packages/db && tsc -p packages/core && tsc -p packages/plugins && tsc -p apps/server && tsc -p apps/studio",
    "importar": "node --import tsx scripts/importar.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/node": "^22.20.5",
    "playwright": "1.58.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
